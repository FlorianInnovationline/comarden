# Supabase Configuration
# Get these from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Notes:
# - NEVER commit real values for these to git.
# - .env.local should be in .gitignore (verify before committing).
# - The service_role key bypasses Row Level Security — treat it as a
#   database root password.

# Catalog reader access tokens — no defaults; required for /catalog-secret.
CATALOG_TOKEN=your-catalog-token-here
CATALOG_ADMIN_TOKEN=your-catalog-admin-token-here
