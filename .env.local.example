# ===========================================================================
# Comarden — environment template
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API). Never commit real keys.
#
# Also add these to Vercel (Project → Settings → Environment Variables).
# ===========================================================================

# Supabase project URL (e.g. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SERVER-ONLY. Never imported in client code.
# Bypasses RLS; treat it like a database root password.
SUPABASE_SERVICE_ROLE_KEY=
